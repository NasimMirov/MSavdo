# Frontend API origin.
# Local development: http://localhost:3000
# Production: set the deployed API origin, or leave empty when served by the same origin.
VITE_API_BASE_URL=http://localhost:3000
ADMIN_ALLOWED_ORIGINS=http://localhost:5173

# Server-only variables. Configure real values in deployment secrets, never in this file.
GEMINI_API_KEY=
ADMIN_JWT_SECRET=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_USERNAME=admin
