# Frontend API origin. Use the same-site HTTPS API hostname so the admin session cookie works.
VITE_API_BASE_URL=https://api.msavdo.shop
# Add the exact HTTPS origin serving the admin frontend; do not use wildcards.
ADMIN_ALLOWED_ORIGINS=https://msavdo.shop,https://www.msavdo.shop

# Server-only variables. Configure real values in deployment secrets, never in this file.
GEMINI_API_KEY=
ADMIN_JWT_SECRET=
PUBLIC_BASE_URL=https://api.msavdo.shop
PUBLIC_SITE_URL=https://msavdo.shop
# Client ID of @msavdo_login_bot; register https://msavdo.shop in BotFather > Login Widget.
TELEGRAM_LOGIN_CLIENT_ID=
# Exactly two numeric Telegram user IDs are allowed to enter the admin panel.
ADMIN_TELEGRAM_ALLOWED_IDS=8296058938,1458452435
