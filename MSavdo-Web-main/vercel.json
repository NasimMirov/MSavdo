{
  "proxy": {
    "entrypoint": "proxy.js",
    "matcher": ["/"]
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.msavdo.shop" }],
      "destination": "https://msavdo.shop/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/product/:path*", "destination": "https://api.msavdo.shop/product/:path*" },
    { "source": "/catalog/:path*", "destination": "https://api.msavdo.shop/catalog/:path*" },
    { "source": "/sitemap.xml", "destination": "https://api.msavdo.shop/sitemap.xml" },
    { "source": "/sitemap-products-:page.xml", "destination": "https://api.msavdo.shop/sitemap-products-:page.xml" }
  ]
}
